---
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';
import SpecMap from '../components/islands/SpecMap.tsx';
import RacketBalls, { type BallRacket } from '../components/islands/RacketBalls.tsx';
import { classMeta } from '../lib/classification';
import { formatPrice } from '../lib/format';
import { racketImage } from '../lib/images';
import { catalog } from '../lib/data';
import { getTerm } from '../lib/glossary';
import { AXES, AXIS_ORDER, buildSpecPoints, variantValues, type AxisKey } from '../lib/specmap';

const points = buildSpecPoints(catalog);
const axisHelp: Partial<Record<AxisKey, string>> = {};
for (const k of AXIS_ORDER) {
  const g = AXES[k].glossary ? getTerm(AXES[k].glossary!) : undefined;
  if (g) axisHelp[k] = g.short;
}

// One ball per racket: each spec is the midpoint across its weight classes, with the
// range kept for the label.
const balls: BallRacket[] = [];
for (const r of catalog) {
  const perVariant = r.variants.map((v) => variantValues(r, v));
  const values = {} as BallRacket['values'];
  const ranges = {} as BallRacket['ranges'];
  for (const k of AXIS_ORDER) {
    const nums = perVariant.map((v) => v[k]).filter((n): n is number => n !== null);
    if (!nums.length) {
      values[k] = null;
      ranges[k] = null;
      continue;
    }
    const lo = Math.min(...nums);
    const hi = Math.max(...nums);
    values[k] = (lo + hi) / 2;
    ranges[k] = [lo, hi];
  }
  const img = racketImage(r.id);
  balls.push({
    id: r.id,
    name: r.name,
    classification: r.classification,
    classLabel: classMeta(r.classification).label,
    balanceBucket: r.derived.balanceBucket,
    series: r.series,
    weightClasses: r.variants.map((v) => v.weightClass),
    thumb: img ? (await getImage({ src: img, width: 112, format: 'webp' })).src : null,
    priceLabel: formatPrice(r.pricePhp),
    values,
    ranges,
  });
}
---

<Base
  title="Spec map: see how OGKILS rackets differ"
  description="An interactive chart of every OGKILS badminton racket. Plot balance, weight, swing weight, stiffness and more to see how the models differ."
  path="/spec-map"
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <header class="mb-8">
      <p class="section-kicker">Rackets / Spec map</p>
      <h1 class="display-heading is-title mt-2 text-4xl text-fg sm:text-5xl">Spec map</h1>
      <p class="prose-measure mt-3 text-fg-muted">
        Every OGKILS racket in each weight it comes in, plotted by the two specs you choose.
        Rackets close together play alike. Rackets far apart play differently.
      </p>
    </header>

    <div class="catalog-rule pt-5">
      <SpecMap client:only="react" points={points} axisHelp={axisHelp} />
    </div>

    <div class="catalog-rule mt-16 pt-6">
      <RacketBalls client:only="react" rackets={balls} />
    </div>
  </div>
</Base>
