---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ClassificationBadge from '../../components/ClassificationBadge.astro';
import StockBadge from '../../components/StockBadge.astro';
import RacketImage from '../../components/RacketImage.astro';
import SpecRow from '../../components/SpecRow.astro';
import Tooltip from '../../components/Tooltip.astro';
import BuyButtons from '../../components/BuyButtons.astro';
import VariantSelector from '../../components/islands/VariantSelector.tsx';
import { catalog } from '../../lib/data';
import { classMeta } from '../../lib/classification';
import { formatStiffness, trustedGripLengthMm, formatPrice, seriesLine } from '../../lib/format';
import { whoItsForFallback, howItPlaysFallback } from '../../lib/copy';
import { suggestRelated } from '../../lib/related';
import { racketImage } from '../../lib/images';
import { productJsonLd, breadcrumbJsonLd } from '../../lib/jsonld';
import type { Racket } from '../../lib/types';

export function getStaticPaths() {
  return catalog.map((racket) => ({ params: { id: racket.id }, props: { racket } }));
}

interface Props {
  racket: Racket;
}
const { racket: r } = Astro.props;

const meta = classMeta(r.classification);
const stiff = formatStiffness(r.stiffness, r.derived.stiffnessWordConflict);
const gripLen = trustedGripLengthMm(r);
const whoFor = r.whoItsFor ?? whoItsForFallback(r);
const howItPlays = r.description ?? howItPlaysFallback(r);
const related = suggestRelated(r, 3);
const price = formatPrice(r.pricePhp);
const series = seriesLine(r);

const site = Astro.site!;
const img = racketImage(r.id);
const ogSrc = img ? (await getImage({ src: img, width: 600 })).src : undefined;
const ogAbs = ogSrc ? new URL(ogSrc, site).href : undefined;
const jsonLd = [
  productJsonLd(site, r, whoFor, ogAbs),
  breadcrumbJsonLd(site, [
    { name: 'Lineup', path: '/rackets' },
    { name: r.name, path: `/rackets/${r.id}` },
  ]),
];
---

<Base
  title={`${r.name} — specs, variants & where to buy | OGKILS`}
  description={r.tagline ?? `Full spec sheet for the OGKILS ${r.name} (${r.modelCode}): weight, balance, stiffness, and every variant.`}
  path={`/rackets/${r.id}`}
  ogImage={ogSrc}
  ogType="product"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6 text-xs font-bold uppercase tracking-[0.08em] text-fg-faint">
      <a href="/rackets" class="transition-colors hover:text-brand-strong">Lineup</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-fg-muted">{r.name}</span>
    </nav>

    <!-- Hero: artwork stage + identity + buy -->
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-10">
      <div class="catalog-rule border-x border-b border-line bg-panel p-4">
        <RacketImage racket={r} eager sizes="(max-width: 1023px) 100vw, 480px" />
      </div>

      <div class="flex flex-col">
        {series && <p class="category-label">{series}</p>}
        <h1 class="display-heading is-title mt-2 text-4xl text-fg sm:text-5xl">{r.name}</h1>

        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
          <ClassificationBadge classification={r.classification} size="md" />
          <StockBadge level={r.stockLevel} size="md" />
        </div>

        {r.tagline && <p class="prose-measure mt-4 text-lg text-fg-muted">{r.tagline}</p>}

        <div class="mt-6 border-t border-line pt-5">
          {
            price ? (
              <span class="tnum text-3xl font-extrabold tracking-tight text-fg">{price}</span>
            ) : (
              <span class="text-sm text-fg-muted">Price shown at the store</span>
            )
          }
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-2">
          <BuyButtons racket={r} placement="detail" layout="row" />
          <button
            type="button"
            data-compare-toggle={r.id}
            aria-pressed="false"
            aria-label={`Add ${r.name} to comparison`}
            class="compare-btn min-h-[2.875rem] px-4 text-[0.75rem]"
          >
            <span class="compare-btn-add">＋ Add to compare</span>
            <span class="compare-btn-on">✓ Added to compare</span>
          </button>
        </div>

        <!-- Who it's for -->
        <section class="mt-8 border-t border-line pt-6">
          <h2 class="panel-heading text-fg-muted">Who it's for</h2>
          <p class="mt-3 leading-relaxed text-fg-muted">{whoFor}</p>
        </section>
      </div>
    </div>

    <!-- How it plays (generated, fact-based prose for SEO + context) -->
    <section class="mt-12 border-t border-line pt-8">
      <h2 class="panel-heading text-fg-muted">How it plays</h2>
      <p class="prose-measure mt-3 leading-relaxed text-fg-muted">{howItPlays}</p>
    </section>

    <!-- Specs -->
    <div class="mt-12 grid gap-8 lg:grid-cols-[1fr_20rem] lg:gap-10">
      <!-- Frame (racket-level) specs -->
      <section aria-labelledby="frame-specs">
        <h2 id="frame-specs" class="catalog-rule panel-heading pt-3">Frame</h2>
        <dl class="mt-3">
          <div class="flex items-baseline justify-between gap-4 border-b border-line py-2.5">
            <dt class="text-sm text-fg-muted">Classification</dt>
            <dd class="text-right text-sm font-medium text-fg">{meta.label}</dd>
          </div>
          <SpecRow label="Balance" value={r.balance} termKey="balance-label" mono={false} />
          <div class="flex items-baseline justify-between gap-4 border-b border-line py-2.5">
            <dt class="flex items-center text-sm text-fg-muted">Stiffness<Tooltip termKey="shaft-stiffness" /></dt>
            <dd class="text-right">
              <span class="tnum text-[0.95rem] font-semibold text-fg">{stiff.primary}</span>
              {stiff.label && <span class="ml-1.5 text-xs text-fg-faint">{stiff.label}</span>}
            </dd>
          </div>
          <SpecRow label="Shaft diameter" value={r.shaftDiameterMm} unit="mm" termKey="shaft-diameter" />
          <SpecRow label="Frame holes" value={r.frameHoleType} termKey="frame-holes" mono={false} />
          <SpecRow label="Frame area" value={r.frameAreaCm2} unit="cm²" termKey="frame-area" />
          <SpecRow label="Grip length" value={gripLen} unit="mm" termKey="grip-size" />
          <SpecRow label="Racket length" value={r.racketLengthMm} unit="mm" />
        </dl>

        <!-- Materials -->
        <h3 class="panel-heading mt-8 text-fg-muted">Materials</h3>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {
            r.materials.map((m) => (
              <li class="rounded-[2px] border border-line bg-panel px-2.5 py-1.5 text-[0.7rem] font-bold uppercase tracking-[0.04em] text-fg-muted">
                {m}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Variant (sticky on desktop) -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="catalog-rule border-x border-b border-line bg-panel p-5">
          <h2 class="panel-heading">By weight class</h2>
          <div class="mt-4">
            <VariantSelector client:load variants={r.variants} />
          </div>
        </div>
      </aside>
    </div>

    <!-- Suggested comparisons -->
    {
      related.length > 0 && (
        <section class="mt-16 border-t border-line pt-10">
          <p class="section-kicker">Head to head</p>
          <h2 class="display-heading mt-2 text-2xl text-fg sm:text-3xl">Compare {r.name} with</h2>
          <div class="catalog-rule mt-5 grid gap-3 pt-5 sm:grid-cols-3">
            {related.map((o) => (
              <a
                href={`/compare?ids=${r.id},${o.id}`}
                class="lift group flex items-center gap-3 border border-line bg-panel p-3 transition-colors hover:border-brand hover:bg-panel-2"
              >
                <RacketImage
                  racket={o}
                  sizes="56px"
                  widths={[112]}
                  class="stage--thumb h-14 w-14 shrink-0"
                />
                <div class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-extrabold uppercase tracking-[0.02em] text-fg">
                    {o.name}
                  </span>
                  <span class="category-label mt-0.5 block text-[0.62rem]">
                    {classMeta(o.classification).label}
                  </span>
                </div>
                <span class="shrink-0 text-brand-strong transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
