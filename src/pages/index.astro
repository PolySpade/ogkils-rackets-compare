---
import Base from '../layouts/Base.astro';
import RacketCard from '../components/RacketCard.astro';
import RacketImage from '../components/RacketImage.astro';
import { catalog, getRacket } from '../lib/data';
import { CLASSIFICATION_META } from '../lib/classification';
import { organizationJsonLd } from '../lib/jsonld';
import { seriesLine, formatWeightClasses, racketBalanceRange, formatStiffness } from '../lib/format';
import type { Classification } from '../lib/types';

const classifications = Object.keys(CLASSIFICATION_META) as Classification[];
const featured = ['fire-breathing', 'wind-breathing', 'dimensional-slash-pro']
  .map((id) => getRacket(id))
  .filter((r): r is NonNullable<typeof r> => Boolean(r));

// The campaign panel rotates through the models being pushed this season. Each asset is a
// full-bleed poster in its own colour world (violet, ice, fire), so the slideshow reads as
// three campaigns rather than one template repeated — the interface chrome stays turquoise
// so the artwork keeps the energy (DESIGN.md, "Composition, imagery, and surfaces").
const heroSlides = ['insect-breathing', 'annihilation', 'ld88dpro']
  .map((id) => getRacket(id))
  .filter((r): r is NonNullable<typeof r> => Boolean(r))
  .map((racket) => {
    const stiffness = formatStiffness(racket.stiffness, racket.derived.stiffnessWordConflict);
    return {
      racket,
      series: seriesLine(racket),
      // Three published figures, so the panel below the artwork carries catalogue
      // information rather than empty space when the copy column runs taller.
      specs: [
        { label: 'Weight', value: formatWeightClasses(racket.variants) },
        { label: 'Balance point', value: `${racketBalanceRange(racket)} mm` },
        { label: 'Stiffness', value: stiffness.label ?? stiffness.primary },
      ],
    };
  });
---

<Base
  title="OGKILS Racket Compare — pick your OGKILS badminton racket"
  path="/"
  jsonLd={organizationJsonLd(Astro.site!)}
>
  <section class="home-hero mx-auto max-w-6xl px-4 sm:px-6">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-line" /> OGKILS 2026 racket collection</p>
      <h1>Find your<br /><span class="hero-emphasis">winning</span><br />racket.</h1>
      <p class="hero-description">
        More power, quicker reactions, or a little of everything. Get to know the OGKILS
        lineup and find a racket for the way you play.
      </p>
      <div class="hero-actions">
        <a href="/finder" class="primary-action press">Find my racket <span aria-hidden="true">↗</span></a>
        <a href="/rackets" class="secondary-action press">Explore the lineup <span aria-hidden="true">→</span></a>
      </div>
      <p class="hero-note">A few quick questions. Three matched picks. No guesswork.</p>
      <div class="hero-facts" aria-label="About this guide">
        <div><strong>{catalog.length}</strong><span>rackets to explore</span></div>
        <div><strong>4</strong><span>playing styles</span></div>
        <div><strong>Your game</strong><span>the starting point</span></div>
      </div>
    </div>

    <!-- Campaign panel. Each artwork is a poster in its own right, so it is shown whole
         with its caption on a clean surface underneath rather than overprinted.
         The track is a scroll-snap rail: it swipes with no JavaScript at all, and the
         script below only adds the arrows, auto-advance and its pause control. Slide
         captions sit inside each link as plain elements rather than figure/figcaption,
         because figcaption is only valid as a direct child of figure. -->
    <section
      class="hero-visual"
      data-hero-carousel
      aria-roledescription="carousel"
      aria-label="Featured rackets from the 2026 collection"
    >
      <ul class="hero-carousel-track" data-carousel-track>
        {
          heroSlides.map((slide, i) => (
            <li
              class="hero-slide"
              id={`hero-slide-${i}`}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${heroSlides.length} — ${slide.racket.name}`}
            >
              <a href={`/rackets/${slide.racket.id}`} class="hero-visual-link">
                <RacketImage
                  racket={slide.racket}
                  eager={i === 0}
                  sizes="(max-width: 639px) 100vw, 620px"
                  widths={[400, 500]}
                />
                <span class="hero-visual-caption">
                  <span class="model">{slide.racket.name}</span>
                  <span class="meta">{slide.series ?? '2026 collection'}</span>
                </span>
                <dl class="hero-visual-specs">
                  {slide.specs.map((spec) => (
                    <div>
                      <dt>{spec.label}</dt>
                      <dd class="tnum">{spec.value}</dd>
                    </div>
                  ))}
                </dl>
                <span class="hero-visual-cta">
                  See the full spec sheet
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M5 12h13m-5-6 6 6-6 6" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="hero-carousel-rail">
        <button
          type="button"
          class="hero-carousel-step"
          data-carousel-prev
          aria-label="Previous racket"
          hidden
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 18 9 12l6-6" />
          </svg>
        </button>

        <ol class="hero-carousel-dots">
          {
            heroSlides.map((slide, i) => (
              <li>
                <a
                  href={`#hero-slide-${i}`}
                  data-carousel-dot={i}
                  aria-current={i === 0 ? 'true' : undefined}
                >
                  <span class="hero-carousel-dot-track">
                    <span class="hero-carousel-dot-fill" />
                  </span>
                  <span class="sr-only">{slide.racket.name}</span>
                </a>
              </li>
            ))
          }
        </ol>

        <button
          type="button"
          class="hero-carousel-step"
          data-carousel-next
          aria-label="Next racket"
          hidden
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>

        <button
          type="button"
          class="hero-carousel-step hero-carousel-toggle"
          data-carousel-toggle
          aria-label="Pause the slideshow"
          hidden
        >
          <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M10 5v14M14 5v14" />
          </svg>
          <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8 5.5v13l11-6.5z" />
          </svg>
        </button>
      </div>

      <p class="sr-only" aria-live="off" data-carousel-status></p>
    </section>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6" aria-label="Ways to explore">
    <div class="explore-grid">
      <a href="/compare" class="explore-link group">
        <span class="explore-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="8" width="6" height="12" rx="1" />
            <rect x="14" y="4" width="6" height="16" rx="1" />
          </svg>
        </span>
        <div>
          <h2>Have a shortlist?</h2>
          <p>Compare up to four rackets, side by side.</p>
        </div>
        <span class="explore-arrow" aria-hidden="true">↗</span>
      </a>
      <a href="/guide/racket-specs" class="explore-link group">
        <span class="explore-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 6.5C10 4.8 6.5 4.5 4 5.5v13c2.5-1 6-.7 8 1 2-1.7 5.5-2 8-1v-13c-2.5-1-6-.7-8 1Z" />
            <path d="M12 6.5v13" />
          </svg>
        </span>
        <div>
          <h2>Make sense of the specs</h2>
          <p>Simple explanations for a more confident choice.</p>
        </div>
        <span class="explore-arrow" aria-hidden="true">↗</span>
      </a>
    </div>

    <!-- Playing-style key: four quiet catalogue columns, one per classification. -->
    <section class="pt-12" aria-labelledby="styles-heading">
      <p class="section-kicker">Performance classes</p>
      <h2 id="styles-heading" class="display-heading mt-2 text-2xl text-fg sm:text-3xl">
        Different styles. One that's yours.
      </h2>
      <dl class="style-key catalog-rule mt-5 pt-5">
        {
          classifications.map((c) => (
            <div>
              <dt>{CLASSIFICATION_META[c].label}</dt>
              <dd>{CLASSIFICATION_META[c].blurb}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </section>

  <!-- Featured -->
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6" aria-labelledby="lineup-heading">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <div>
        <p class="section-kicker">Rackets / 2026</p>
        <h2 id="lineup-heading" class="display-heading mt-2 text-3xl text-fg sm:text-4xl">
          Meet the lineup
        </h2>
      </div>
      <a
        href="/rackets"
        class="pb-1 text-[0.72rem] font-extrabold uppercase tracking-[0.1em] text-brand-strong transition-colors hover:text-fg"
      >
        Browse all {catalog.length} →
      </a>
    </div>
    <div class="catalog-rule mt-5 grid gap-5 pt-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((r) => (
          <RacketCard racket={r} sizes="(max-width: 639px) 100vw, (max-width: 1023px) 45vw, 360px" />
        ))
      }
    </div>
  </section>

  <!-- Spec guide teaser -->
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6">
    <div class="catalog-rule flex flex-col gap-5 border-x border-b border-line bg-panel p-8 sm:flex-row sm:items-center sm:justify-between">
      <div class="prose-measure">
        <h2 class="text-xl font-extrabold tracking-tight text-fg">New to reading racket specs?</h2>
        <p class="mt-2 leading-relaxed text-fg-muted">
          “4U”, “balance point”, “shaft stiffness” — we explain what each one actually does
          for your game, in plain language. Every spec on the site links back to it.
        </p>
      </div>
      <a href="/guide/racket-specs" class="secondary-action shrink-0">
        Read the spec guide <span aria-hidden="true">→</span>
      </a>
    </div>

    <p class="prose-measure mt-10 text-xs leading-relaxed text-fg-faint">
      Every figure is drawn from the official OGKILS product database and shown as
      published. Where a spec is unavailable it reads “—”, never a zero.
    </p>
  </section>
</Base>

<script>
  // Progressive enhancement for the campaign carousel. The track already swipes on its
  // own via scroll-snap and the dots already work as in-page anchors, so everything this
  // adds is revealed only once it can actually function.
  const AUTOPLAY_MS = 6000;

  function initHeroCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const dots = [...root.querySelectorAll<HTMLAnchorElement>('[data-carousel-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-carousel-toggle]');
    const status = root.querySelector<HTMLElement>('[data-carousel-status]');
    const slides = [...root.querySelectorAll<HTMLElement>('.hero-slide')];
    if (!track || slides.length < 2) return;

    for (const control of [prev, next, toggle]) control?.removeAttribute('hidden');

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let timer: number | undefined;
    // Autoplay is opt-out for most visitors but never starts for a reduced-motion one.
    let playing = !reduced.matches;

    const go = (to: number, smooth = true) => {
      index = (to + slides.length) % slides.length;
      track.scrollTo({
        left: index * track.clientWidth,
        behavior: smooth && !reduced.matches ? 'smooth' : 'auto',
      });
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      if (playing) timer = window.setInterval(() => go(index + 1), AUTOPLAY_MS);
    };

    const setPlaying = (on: boolean) => {
      playing = on;
      toggle?.classList.toggle('is-paused', !on);
      toggle?.setAttribute('aria-label', on ? 'Pause the slideshow' : 'Play the slideshow');
      // While slides advance on their own, announcing each one would talk over the reader.
      // Once it is paused, movement is user-driven, so changes become worth announcing.
      status?.setAttribute('aria-live', on ? 'off' : 'polite');
      on ? start() : stop();
    };

    // Driven by the scroll position rather than the click, so a swipe, an anchor jump and
    // a button press all end up reporting the same thing.
    const sync = () => {
      const at = Math.round(track.scrollLeft / track.clientWidth);
      if (at === index && dots[at]?.getAttribute('aria-current') === 'true') return;
      index = at;
      dots.forEach((dot, i) => {
        if (i === at) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      const name = slides[at]?.getAttribute('aria-label');
      if (status && name) status.textContent = name;
    };

    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(sync);
    });

    prev?.addEventListener('click', () => {
      setPlaying(false);
      go(index - 1);
    });
    next?.addEventListener('click', () => {
      setPlaying(false);
      go(index + 1);
    });
    toggle?.addEventListener('click', () => setPlaying(!playing));

    dots.forEach((dot, i) =>
      dot.addEventListener('click', (e) => {
        e.preventDefault(); // keep the page still; scroll the rail instead of jumping to it
        setPlaying(false);
        go(i);
      }),
    );

    root.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      setPlaying(false);
      go(e.key === 'ArrowLeft' ? index - 1 : index + 1);
    });

    // Hovering or tabbing in means someone is reading this slide — hold it there, then
    // resume only if they never took manual control.
    root.addEventListener('pointerenter', stop);
    root.addEventListener('focusin', stop);
    root.addEventListener('pointerleave', () => playing && start());
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node) && playing) start();
    });
    document.addEventListener('visibilitychange', () =>
      document.hidden ? stop() : playing && start(),
    );
    reduced.addEventListener('change', (e) => e.matches && setPlaying(false));
    window.addEventListener('resize', () => go(index, false));

    setPlaying(playing);
  }

  function setupHeroCarousels() {
    document
      .querySelectorAll<HTMLElement>('[data-hero-carousel]')
      .forEach((el) => initHeroCarousel(el));
  }

  setupHeroCarousels();
  // Astro View Transitions swap the DOM without a reload, so re-bind on every navigation.
  document.addEventListener('astro:after-swap', setupHeroCarousels);
</script>
