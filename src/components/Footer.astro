---
import Logo from './Logo.astro';

const year = 2026; // static build; update on rebuild

const columns = [
  {
    title: 'Rackets',
    links: [
      { href: '/rackets', label: 'Browse the lineup' },
      { href: '/finder', label: 'Find my racket' },
      { href: '/compare', label: 'Compare rackets' },
    ],
  },
  {
    title: 'Knowledge',
    links: [{ href: '/guide/racket-specs', label: 'How to read racket specs' }],
  },
];
---

<footer class="mt-24 border-t-[3px] border-brand bg-panel-2">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-[minmax(0,1.3fr)_repeat(2,minmax(0,1fr))] sm:gap-12">
      <div class="max-w-sm">
        <Logo class="h-5 w-auto text-fg" />
        <p class="mt-4 text-sm leading-relaxed text-fg-muted">
          A spec-for-spec guide to the OGKILS racket lineup. This isn't a store —
          when you've found your racket, we send you to buy it wherever you shop.
        </p>
        <a
          href="https://ogkilsbadminton.com"
          rel="noopener"
          class="mt-5 inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-[0.08em] text-brand-strong hover:text-fg transition-colors"
        >
          OGKILS store <span aria-hidden="true">↗</span>
        </a>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <h2 class="panel-heading text-fg-muted">{col.title}</h2>
            <ul class="mt-3 flex flex-col">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="inline-block py-1.5 text-sm text-fg-muted transition-colors hover:text-brand-strong"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <p class="mt-12 border-t border-line pt-6 text-xs leading-relaxed text-fg-faint">
      © {year} OGKILS. Specifications sourced from the official OGKILS product
      database and shown as published. Where a figure is unavailable it is marked “—”.
    </p>
  </div>
</footer>
