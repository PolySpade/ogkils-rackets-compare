---
import { getTerm } from '../lib/glossary';

interface Props {
  /** Glossary key, e.g. "balance-point". Deep-links to the guide anchor. */
  termKey: string;
}

const { termKey } = Astro.props;
const term = getTerm(termKey);
---

{
  term && (
    <span class="tt">
      <a
        class="spec-help"
        href={`/guide/racket-specs#${termKey}`}
        aria-label={`What is ${term.term}? Opens the spec guide.`}
      >
        ?
      </a>
      <span class="tt-pop" role="tooltip">
        <span class="tt-term">{term.term}</span>
        {term.short}
      </span>
    </span>
  )
}

<style>
  .tt {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
  }
  /* A quiet catalogue note, not a dark app tooltip: panel surface, thin rule, 3px
     corners, and a shadow light enough to sit on a white product page. */
  .tt-pop {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    width: max-content;
    max-width: min(18rem, 70vw);
    padding: 0.625rem 0.75rem;
    /* Square, like every other ruled panel in the catalogue — the 3px brand rule is the
       site's section marker and needs a straight edge to sit on, so no radius here. */
    border: 1px solid var(--color-line-strong);
    border-top: 3px solid var(--color-brand);
    background: var(--color-panel);
    color: var(--color-fg-muted);
    font-size: 0.8rem;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: normal;
    text-transform: none;
    text-align: left;
    box-shadow: 0 10px 28px -14px rgb(33 22 19 / 0.45);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.12s var(--ease-out),
      visibility 0.12s var(--ease-out);
    pointer-events: none;
  }
  :global(html[data-theme="dark"]) .tt-pop {
    box-shadow: 0 10px 28px -12px rgb(0 0 0 / 0.7);
  }
  .tt-term {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--color-fg);
    font-weight: 700;
  }
  .tt:hover .tt-pop,
  .tt:focus-within .tt-pop {
    opacity: 1;
    visibility: visible;
  }

  /* The hover note is an extra for pointer devices. On touch there is no hover state to
     reveal it, and a popup wide enough to read would hang off a phone screen — so it is
     simply not rendered there. The trigger itself is a real link to the glossary entry
     (with the term in its accessible name), which is the affordance that always works. */
  @media not all and (hover: hover) {
    .tt-pop {
      display: none;
    }
  }

  /* In a narrow hover-capable window, hang the note from the trigger's left edge rather
     than centring it off the side of the viewport. */
  @media (hover: hover) and (max-width: 700px) {
    .tt-pop {
      left: 0;
      transform: none;
      max-width: min(18rem, calc(100vw - 7rem));
    }
  }
</style>
