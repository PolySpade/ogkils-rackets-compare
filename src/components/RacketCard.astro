---
import ClassificationBadge from './ClassificationBadge.astro';
import StockBadge from './StockBadge.astro';
import RacketImage from './RacketImage.astro';
import {
  formatStiffness,
  formatWeightClasses,
  formatGripSizes,
  racketBalanceRange,
  formatPrice,
  seriesLine,
} from '../lib/format';
import type { Racket } from '../lib/types';

interface Props {
  racket: Racket;
  /** Sizes hint for the card's image stage. */
  sizes?: string;
}

const { racket: r, sizes = '(max-width: 639px) 100vw, (max-width: 1279px) 45vw, 360px' } =
  Astro.props;
const stiff = formatStiffness(r.stiffness, r.derived.stiffnessWordConflict);
const weights = r.variants.map((v) => v.weightClass).join(' ');
const grips = formatGripSizes(r.variants).split(' · ').join(' ');
const price = formatPrice(r.pricePhp);
const series = seriesLine(r);
---

<article
  data-racket-card
  data-classification={r.classification}
  data-series={r.series}
  data-balance={r.balance}
  data-weights={weights}
  data-grips={grips}
  data-stiffness={r.stiffness.word}
  class="lift group racket-card relative flex flex-col border border-line bg-panel transition-colors hover:border-brand"
>
  <a href={`/rackets/${r.id}`} class="flex flex-1 flex-col">
    <!-- Campaign artwork, shown whole on its own stage -->
    <RacketImage racket={r} sizes={sizes} class="border-b border-line" />

    <div class="flex flex-1 flex-col p-5">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          {series && <p class="category-label text-[0.68rem]">{series}</p>}
          <h3
            class="mt-1 text-base font-extrabold uppercase leading-tight tracking-tight text-fg"
            style="overflow-wrap:break-word;"
          >{r.name}</h3>
        </div>
        {price && <span class="tnum shrink-0 text-sm font-bold text-fg">{price}</span>}
      </div>

      <div class="mt-3"><ClassificationBadge classification={r.classification} /></div>

      <dl class="mt-5 mb-5 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-line pt-4 text-sm">
        <div>
          <dt class="text-xs text-fg-faint">Weight</dt>
          <dd class="tnum text-fg">{formatWeightClasses(r.variants)}</dd>
        </div>
        <div>
          <dt class="text-xs text-fg-faint">Balance point</dt>
          <dd class="tnum text-fg">{racketBalanceRange(r)}<span class="spec-unit">mm</span></dd>
        </div>
        <div>
          <dt class="text-xs text-fg-faint">Stiffness</dt>
          <dd class="tnum text-fg">
            {stiff.primary}
            {stiff.label && <span class="ml-1 text-xs text-fg-faint">{stiff.label}</span>}
          </dd>
        </div>
        <div>
          <dt class="text-xs text-fg-faint">Grip</dt>
          <dd class="tnum text-fg">{formatGripSizes(r.variants)}</dd>
        </div>
      </dl>

      <div class="mt-auto flex items-center justify-between gap-3 border-t border-line pt-4">
        <StockBadge level={r.stockLevel} />
        <span class="text-xs font-bold uppercase tracking-[0.06em] text-fg-muted transition-colors group-hover:text-brand-strong">
          View specs →
        </span>
      </div>
    </div>
  </a>

  <!-- Add-to-compare sits top-right: the campaign artwork carries the OGKILS badge
       in its own top-left corner, and covering it looked like a rendering fault. -->
  <button
    type="button"
    data-compare-toggle={r.id}
    aria-pressed="false"
    aria-label={`Add ${r.name} to comparison`}
    class="compare-btn absolute right-2 top-2 z-10"
  >
    <span class="compare-btn-add">＋ Compare</span>
    <span class="compare-btn-on">✓ Added</span>
  </button>
</article>
