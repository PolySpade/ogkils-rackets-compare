---
/**
 * The OGKILS brand mark, taken from the vector artwork in OGKILS-2026 Brochure.pdf
 * (p.3 lockup). Paths are unmodified, so the proportions are the official ones;
 * `fill: currentColor` lets the header, footer and dark theme colour it without
 * shipping a second raster file. Matches the brand PNG supplied by OGKILS.
 */
interface Props {
  /** "lockup" = mark + OGKILS wordmark; "mark" = the four-bar symbol alone. */
  variant?: "lockup" | "mark";
  class?: string;
  /** Accessible name. Pass null when an adjacent element already names the link. */
  label?: string | null;
}
const { variant = "lockup", class: cls = "", label = "OGKILS" } = Astro.props;
const a11y = label
  ? ({ role: "img", "aria-label": label } as const)
  : ({ "aria-hidden": "true" } as const);
---

{
  variant === "mark" ? (
    <svg
      viewBox="221.36 600.66 30.04 24.65"
      fill="currentColor"
      fill-rule="nonzero"
      class={cls}
      {...a11y}
    >
      <path d="M 224.425781 600.65625 L 221.359375 607.570312 L 236.582031 607.570312 L 239.648438 600.65625 Z M 224.425781 600.65625 " />
      <path d="M 234.882812 611.394531 L 231.816406 618.308594 L 224.253906 618.308594 L 227.320312 611.394531 Z M 234.882812 611.394531 " />
