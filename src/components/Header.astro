---
import Logo from './Logo.astro';

const links = [
  { href: '/finder', label: 'Find my racket', short: 'Find' },
  { href: '/rackets', label: 'Browse', short: 'Browse' },
  { href: '/compare', label: 'Compare', short: 'Compare' },
  { href: '/guide/racket-specs', label: 'Guide', short: 'Guide' },
];
const here = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-ink/92 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-stretch gap-4 px-4 sm:h-18 sm:px-6">
    <a
      href="/"
      class="group flex shrink-0 items-center gap-3"
      aria-label="OGKILS Racket Compare — home"
    >
      <Logo class="h-5 w-auto text-fg transition-colors group-hover:text-brand-strong sm:h-[1.4rem]" label={null} />
      <span
        class="border-l border-line pl-3 text-[0.6rem] font-extrabold uppercase leading-[1.15] tracking-[0.14em] text-fg-muted transition-colors group-hover:text-brand-strong sm:text-[0.65rem]"
      >Racket<br />Compare</span>
    </a>

    <div class="ml-auto flex items-stretch gap-1 sm:gap-2">
      <nav aria-label="Primary" class="hidden items-stretch sm:flex">
        {
          links.map((l) => (
            <a
              href={l.href}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                'flex items-center border-b-[3px] px-3 text-xs font-bold uppercase tracking-[0.06em] transition-colors',
                isActive(l.href)
                  ? 'border-brand text-brand-strong'
                  : 'border-transparent text-fg-muted hover:text-brand-strong',
              ]}
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center border-l border-line pl-1 sm:pl-2">
        <button
          type="button"
          data-theme-toggle
          aria-label="Switch between light and dark theme"
          class="icon-btn"
        >
          <svg class="icon-to-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
          <svg class="icon-to-light" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
